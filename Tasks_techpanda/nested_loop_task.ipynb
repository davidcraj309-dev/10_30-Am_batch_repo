   "source": [
    "row = int(input(\"Enter a row number: \"))\n",
    "column = int(input(\"Enter a column number: \"))\n",
    "\n",
    "\n",
    "i = 1\n",
    "\n",
    "while row>=i:\n",
    "    j =  1\n",
    "\n",
    "    while column>=j:\n",
    "        print(i,end=\"\")\n",
    "        j += 1\n",
    "\n",
    "    i += 1\n",
    "    print()"
   ]
  }
